# ThoughtMap deployment configuration.
#
# Copy to .env and fill in. .env is git-ignored; .env.example is tracked.
# Never commit real values. Full reference: docs/deployment.md
#
# Three profiles below. Use exactly one.

# ============================================================================
# PROFILE 1 — development (local)
# ============================================================================
# Permissive CORS, lazy loading, Personal Library on, torch-based encoder.
# The only variable that matters is where the embedding artifact lives.

THOUGHTMAP_DEPLOYMENT_MODE=development
THOUGHTMAP_EMBEDDINGS_PATH=D:/ThoughtMap/master/thoughtmap_canonical_embeddings.csv

# Optional: use the production ONNX encoder locally too. Faster to start
# (~1 s vs ~23 s) and needs no torch.
# THOUGHTMAP_ENCODER_PROVIDER=onnx
# THOUGHTMAP_ENCODER_DIR=D:/ThoughtMap/encoder


# ============================================================================
# PROFILE 2 — public-demo  (the T7 release candidate target)
# ============================================================================
# Every variable in this block is REQUIRED unless marked optional.
#
# THOUGHTMAP_DEPLOYMENT_MODE=public-demo
#
# --- corpus -----------------------------------------------------------------
# Absolute path on the persistent disk. Verified against corpus_manifest.json
# at startup; a mismatch fails readiness rather than serving a partial corpus.
# THOUGHTMAP_EMBEDDINGS_PATH=/data/thoughtmap_canonical_embeddings.csv
#
# --- query encoder ----------------------------------------------------------
# ONNX Runtime. Needs no torch and contacts no model registry, so the instance
# is self-contained. A missing or altered encoder fails readiness; it never
# silently falls back to another runtime.
# THOUGHTMAP_ENCODER_PROVIDER=onnx
# THOUGHTMAP_ENCODER_DIR=/data/encoder
#
# --- origins ----------------------------------------------------------------
# Only needed when the frontend is on a DIFFERENT host. Same-origin deployments
# (recommended) can leave this unset. '*' is refused outside development, and
# an unset value in a public mode allows nothing rather than everything.
# THOUGHTMAP_ALLOWED_ORIGINS=https://thoughtmap.example
#
# --- abuse protection -------------------------------------------------------
# Measured: one instance saturates at 6-8 searches/second. 2/s per client with
# a burst of 10 lets a person search freely (a burst covers a page of rapid
# queries) while one client cannot consume the instance. Refusals are 429 with
# Retry-After and cost ~1-2 ms, so a refused flood stays cheap.
# THOUGHTMAP_SEARCH_RATE_LIMIT=2
# THOUGHTMAP_SEARCH_RATE_BURST=10
#
# Only where a proxy overwrites X-Forwarded-For (Render and most CDNs do).
# The header is client-controlled and forgeable otherwise.
# THOUGHTMAP_TRUST_PROXY_HEADERS=true
#
# --- Personal Library -------------------------------------------------------
# OFF. It authenticates nobody: anyone who guesses an address can read and
# modify that library. Do not enable on a public URL until real authentication
# exists. Off is also the default in public modes; this states it explicitly.
# THOUGHTMAP_LIBRARY_ENABLED=false
#
# --- optional ---------------------------------------------------------------
# Hash the 542 MB artifact and the encoder at startup (~6 s). The size check
# already catches the realistic failure; use this for release verification.
# THOUGHTMAP_VERIFY_ARTIFACT_CHECKSUM=false
# THOUGHTMAP_VERIFY_ENCODER_CHECKSUMS=false
#
# ONNX intra-op threads. 2 is the measured knee; higher multiplies threads per
# concurrent request.
# THOUGHTMAP_ENCODER_THREADS=2
#
# off | corpus | full. Public modes default to full, which is what keeps a
# first visitor from paying the load.
# THOUGHTMAP_WARMUP=full
#
# Where prepare_corpus_artifacts fetches from. A signed URL is a credential:
# set it in the host's secret store, never here.
# THOUGHTMAP_EMBEDDINGS_URL=
# THOUGHTMAP_ENCODER_URL=


# ============================================================================
# PROFILE 3 — production
# ============================================================================
# Identical to public-demo, with two differences:
#   - THOUGHTMAP_DEPLOYMENT_MODE=production
#   - the Personal Library may be enabled ONLY once real authentication exists.
#     It does not yet. Until then, production and public-demo are the same
#     offer with a different label.


# ============================================================================
# Frontend (build time)
# ============================================================================
# Where the browser reaches the API. Unset means same-origin /api, which is
# what the reverse-proxy configurations in deploy/ provide, and what removes
# CORS from the deployment entirely.
# VITE_THOUGHTMAP_API_BASE_URL=https://thoughtmap.example/api
